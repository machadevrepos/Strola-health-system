# Firebase "Trigger Email" extension config (Part 4 decision #2).
# SMTP_CONNECTION_URI / SMTP_PASSWORD are intentionally left unset — no real
# SMTP relay credentials exist yet (need a provider: SendGrid, Mailgun,
# Postmark, etc.). The extension deploys and runs fine without them; it just
# can't actually send anything until they're set via:
#   firebase functions:secrets:set ext-firestore-send-email-SMTP_PASSWORD
# and this file gets SMTP_CONNECTION_URI filled in, then redeploy.
# sendPasswordResetForUser / sendAdminEmail / resolveReport's guideline
# notices all write to the MAIL_COLLECTION below already — they'll just sit
# unsent until then.

DATABASE=(default)
DATABASE_REGION=nam5
AUTH_TYPE=UsernamePassword
MAIL_COLLECTION=mail
DEFAULT_FROM=Strolla Health <no-reply@strollahealth.com>
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1
