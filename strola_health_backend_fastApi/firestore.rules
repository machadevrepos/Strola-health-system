rules_version = '2';

// The Admin SDK (used by this backend) bypasses these rules entirely, so they
// only matter if a client SDK is ever pointed at Firestore directly — which
// this architecture deliberately avoids (see README: FastAPI is the only
// API surface). Locked down by default; revisit if that ever changes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
