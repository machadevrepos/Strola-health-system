# Firebase
# Path to a Firebase service account JSON (Firebase Console > Project Settings > Service Accounts).
# Leave unset to use Application Default Credentials (e.g. on Cloud Run).
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# Set to talk to the Firebase Local Emulator Suite instead of live Firebase.
# Example: localhost:8080
FIRESTORE_EMULATOR_HOST=
# Example: localhost:9099
FIREBASE_AUTH_EMULATOR_HOST=

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# RevenueCat (subscriptions) — Project Settings > Webhooks in the RevenueCat dashboard
REVENUECAT_WEBHOOK_AUTH_TOKEN=

# Oura — https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=

# Garmin — Garmin Connect Developer Program
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=

# Strava — https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
