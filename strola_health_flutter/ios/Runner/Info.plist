<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Strolla Health</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Strolla Health</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Portrait-only — every screen in this app is designed for it; see
	     the matching lock in lib/main.dart and AndroidManifest.xml. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- BLE usage descriptions — required by App Store / iOS runtime -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Strolla Health connects to your NRF7002 step counter over Bluetooth to receive live step data.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Strolla Health connects to your NRF7002 step counter over Bluetooth to receive live step data.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Strolla Health uses your location to track your outdoor walks and runs on a map, and to scan for nearby Bluetooth devices.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Strolla Health uses your location to track your outdoor walks and runs on a map, even when the app is in the background during an active session.</string>
	<key>NSMotionUsageDescription</key>
	<string>Strolla Health uses motion sensors to detect your walking and running pace.</string>
	<!-- Photo library / camera — attaching photos to community posts -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Strolla Health needs access to your photos so you can attach an image to your community posts.</string>
	<key>NSCameraUsageDescription</key>
	<string>Strolla Health needs camera access so you can take a photo to attach to your community posts.</string>
	<!-- Apple Health (health package) — required or HealthKit authorization crashes at runtime -->
	<key>NSHealthShareUsageDescription</key>
	<string>Strolla Health reads your steps, distance, and active energy from Apple Health to keep your activity in sync.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Strolla Health writes workout sessions to Apple Health so your activity stays in sync across apps.</string>
	<!-- OAuth callback (flutter_web_auth_2) — Strava/Oura/Garmin redirect here
	     after consent; see integrations_screen.dart -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>strolahealth</string>
			</array>
		</dict>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
