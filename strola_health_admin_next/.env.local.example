# Copy this file to .env.local and adjust if needed.
#
# This panel talks to the real Firebase backend in ../strola_health_firebase
# (Cloud Functions + Firestore, project strolla-health-4c93b) — there is no
# separate REST API server to run. Get these values from a registered
# Firebase Web App: `firebase apps:sdkconfig WEB <appId>` from
# ../strola_health_firebase, or the Firebase console (Project settings →
# General → Your apps).

NEXT_PUBLIC_MOCK_MODE=false

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=strolla-health-4c93b
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=strolla-health-4c93b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=strolla-health-4c93b.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# Set to true to run fully offline against in-memory mock data instead
# (no Firebase project needed at all) — see src/lib/mock-mode.ts.
# NEXT_PUBLIC_MOCK_MODE=true
