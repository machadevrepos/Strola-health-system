# Copy this file to .env.local and adjust if needed (or paste these as
# Environment Variables in the Vercel project settings for this app).
#
# This panel talks to the real Firebase backend in ../strola_health_firebase
# (Cloud Functions + Firestore, project strolla-health-4c93b) — there is no
# separate REST API server to run. Same Firebase Web App config as
# strola_health_super_admin_next — single-project setup, no dev/staging
# split (confirmed decision). A Firebase Web App's config (below) is not a
# secret — it's the public client identifier; access is enforced by
# Firestore security rules and Cloud Functions auth checks, not by hiding
# this file.

NEXT_PUBLIC_MOCK_MODE=false

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBB3lV4opSVuTzo7OKsDRIa9SLIHmDzyFY
NEXT_PUBLIC_FIREBASE_PROJECT_ID=strolla-health-4c93b
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=strolla-health-4c93b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=strolla-health-4c93b.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=334480287391
NEXT_PUBLIC_FIREBASE_APP_ID=1:334480287391:web:397ab9fbd5ce1de91924aa

NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# Set to true to run fully offline against in-memory mock data instead
# (no Firebase project needed at all) — see src/lib/mock-mode.ts.
# NEXT_PUBLIC_MOCK_MODE=true
