# Copy this file to .env.local and adjust if needed — these defaults match
# the backend's own .env.example, so if you haven't changed those, you can
# leave this as-is.

# Backend API — must match the port uvicorn is running on (see backend README).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Firebase — dev-only config pointed at the Local Emulator Suite. The
# emulator doesn't validate apiKey, so this placeholder value is fine; it
# would need a real project's config to point at production.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=strolla-health-dev
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=strolla-health-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
